# ---------------------------------------------------------------------------
# Copy this file to .env for local development and fill in real values.
# NEVER commit .env — it is already listed in .gitignore.
# In production (Netlify), set these under Site Configuration > Environment
# Variables instead of committing them anywhere.
# ---------------------------------------------------------------------------

# Supabase Postgres connection string used by Prisma Client at runtime.
# Use the "Transaction" pooled connection string (port 6543) from
# Supabase > Project Settings > Database > Connection string > Prisma.
DATABASE_URL=""

# Supabase Postgres DIRECT (non-pooled, port 5432) connection string.
# Used only by `prisma migrate` / `prisma db push`, never at request time.
DIRECT_URL=""

# NextAuth / Auth.js signing secret. Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Google OAuth credentials (Google Cloud Console > APIs & Services > Credentials).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Canonical URL NextAuth uses for OAuth callbacks.
# Local: http://localhost:3000  Production: https://your-site.netlify.app
NEXTAUTH_URL="http://localhost:3000"

# Public base URL used client-side (e.g. building QR deep links). Must match
# NEXTAUTH_URL in value but is intentionally a separate NEXT_PUBLIC_ variable
# since it is the only one of this set safe to expose to the browser.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
